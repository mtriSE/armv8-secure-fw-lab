[submodule "third_party/trusted-firmware-a"]
	path = third_party/trusted-firmware-a
	url = https://github.com/TrustedFirmware-A/trusted-firmware-a.git
	shallow = true
[submodule "third_party/optee_os"]
	path = third_party/optee_os
	url = https://github.com/OP-TEE/optee_os.git
	shallow = true
[submodule "third_party/optee_client"]
	path = third_party/optee_client
	url = https://github.com/OP-TEE/optee_client.git
	shallow = true
[submodule "third_party/optee_test"]
	path = third_party/optee_test
	url = https://github.com/OP-TEE/optee_test.git
	shallow = true
[submodule "third_party/u-boot"]
	path = third_party/u-boot
	url = https://source.denx.de/u-boot/u-boot.git
	shallow = true
[submodule "third_party/buildroot"]
	path = third_party/buildroot
	url = https://gitlab.com/buildroot.org/buildroot.git
	shallow = true
[submodule "third_party/linux"]
	path = third_party/linux
	url = https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git
	shallow = true
