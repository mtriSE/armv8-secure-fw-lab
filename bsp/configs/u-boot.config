# Fragment merged on top of U-Boot's qemu_arm64_defconfig (see bsp/Makefile).

# TF-A BL2 loads BL33 at NS_IMAGE_OFFSET = 0x60000000 and BL31 jumps there,
# so U-Boot must be linked to run from that address.
CONFIG_TEXT_BASE=0x60000000

# Load the kernel and initramfs from the host through semihosting ("hostfs").
CONFIG_SEMIHOSTING=y

# kernel_addr_r: 0x42200000, just above OP-TEE's static shared memory
#   (CFG_SHMEM_START 0x42000000 + 2 MiB); U-Boot's default 0x40400000 would
#   put a ~40 MiB Image on top of it.
# ramdisk_addr_r: 0x48000000 leaves ~94 MiB for the kernel Image.
# fdt_addr (0x40000000): the DTB QEMU generated, already patched by TF-A BL2
#   (PSCI node) and OP-TEE (firmware/optee node, reserved memory).
# booti: boot an arm64 Image; "addr:size" passes a raw (not uImage) initramfs.
CONFIG_BOOTDELAY=1
CONFIG_USE_BOOTCOMMAND=y
CONFIG_BOOTCOMMAND="setenv kernel_addr_r 0x42200000 && setenv ramdisk_addr_r 0x48000000 && load hostfs - ${kernel_addr_r} Image && load hostfs - ${ramdisk_addr_r} rootfs.cpio.gz && setenv bootargs console=ttyAMA0,115200 && booti ${kernel_addr_r} ${ramdisk_addr_r}:${filesize} ${fdt_addr}"

# No "-g<commit>" suffix from git (see LOCALVERSION in bsp/Makefile).
# CONFIG_LOCALVERSION_AUTO is not set
