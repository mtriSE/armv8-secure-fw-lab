# Fragment merged on top of arch/arm64/configs/defconfig (see bsp/Makefile).

# OP-TEE driver: /dev/tee0 (clients) and /dev/teepriv0 (tee-supplicant).
CONFIG_TEE=y
CONFIG_OPTEE=y

# lx-* GDB helpers (used from B2 on).
CONFIG_GDB_SCRIPTS=y

# The initramfs is gzip-compressed by Buildroot.
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
